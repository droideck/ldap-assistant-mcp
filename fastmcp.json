{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "path": "src/ldap_assistant_mcp/main.py",
    "entrypoint": "create_server"
  },
  "environment": {
    "type": "uv",
    "python": "3.13",
    "dependencies": [
      "fastmcp>=2.13,<3",
      "lib389>=3.1.3"
    ],
    "editable": ["."]
  },
  "deployment": {
    "transport": "stdio",
    "log_level": "INFO",
    "env": {
      "LDAP_SERVERS_CONFIG": "./servers.json"
    }
  }
}

